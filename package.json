{
  "name": "colabonate-design-system",
  "private": true,
  "version": "0.15.10",
  "license": "MIT",
  "description": "Colabonate Design System â€“ Figma â†’ Token â†’ Code",
  "scripts": {
    "preflight": "node scripts/preflight.js",
    "tokens:build": "node packages/tokens/scripts/build.js",
    "build": "pnpm --recursive --filter=!server build",
    "typecheck": "pnpm --recursive typecheck",
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter colabonate-app dev\" \"pnpm --filter mcp-server dev\"",
    "dev:app": "pnpm --filter colabonate-app dev",
    "dev:server": "pnpm --filter server dev",
    "dev:mcp": "pnpm --filter mcp-server dev",
    "prisma:seed": "pnpm --filter server exec tsx ../../prisma/seed.ts",
    "reinit": "bash scripts/reinit.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --project chromium --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:ci": "pnpm lint:auth && vitest run && playwright test",
    "playwright:install": "playwright install chromium",
    "lint:auth": "tsx scripts/beta/auth-coverage.ts -",
    "rotate:secrets": "tsx scripts/beta/rotate-secrets.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.4.1",
    "@cashu/cashu-ts": "^4.5.1",
    "@libsql/client": "^0.17.4",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/ui": "^4.1.4",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "meilisearch": "^0.48.2",
    "nostr-tools": "^2.23.3",
    "playwright": "1.62.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "express-rate-limit": "^8.3.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0"
  }
}
