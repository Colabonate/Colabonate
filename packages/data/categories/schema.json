{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colabonate.com/schemas/categories-v2.json",
  "title": "Colabonate Category Schema v2",
  "description": "Schema for UNSPSC-referenced category definitions (v2 – Universal Catalog)",
  "type": "object",
  "required": ["version", "standard", "categories"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "standard": { "type": "string", "enum": ["UNSPSC"] },
    "standardVersion": { "type": "string" },
    "maxLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
    "supersedes": { "type": "string", "description": "Previous version file this replaces" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "nameKey", "name", "offerType", "level"],
        "properties": {
          "id":          { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "slug":        { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(/[a-z][a-z0-9_-]*)*$" },
          "nameKey":     { "type": "string", "pattern": "^[a-z][a-z0-9_-]*([.][a-z][a-z0-9_-]*)*$" },
          "unspscCode":  { "type": "string", "pattern": "^\\d{8}$" },
          "name":        { "type": "string" },
          "offerType":   { "type": "string", "enum": ["PRODUCT", "SERVICE"] },
          "level":       { "type": "integer", "minimum": 1, "maximum": 5 },
          "color":       { "type": "string", "description": "MUI Chip color variant (e.g. info, primary, secondary)" },
          "subcategories": {
            "type": "array",
            "items": { "$ref": "#/properties/categories/items" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
