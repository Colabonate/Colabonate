# ── Database (PostgreSQL — ADR-139) ───────────────────────────────────────────
# Pooled connection (app uses this)
# NOTE: If port 5432 is occupied (Supabase/LocalAI), use 5434 — see docker-compose.dev.yml
DATABASE_URL=postgresql://colabonate:dev@localhost:5434/colabonate
# Direct connection (prisma migrate uses this)
DIRECT_URL=postgresql://colabonate:dev@localhost:5434/colabonate

# ── Redis (ADR-139) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Meilisearch (ADR-139) ────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key
# Empty = relative URLs via Vite proxy (works on any host/IP, incl. WLAN).
# Set to absolute URL only when frontend and backend run on different origins.
VITE_API_URL=
APP_PORT=4001
BASE_URL=http://localhost:4001

# ── Nostr Relay Configuration ────────────────────────────────────────────────
# Mock Relay (development): ws://localhost:4001 (attached via index.ts:592)
# Production: wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# NOSTR_RELAY_URLS=ws://localhost:4001
#
# Mock Relay Details:
# - In-memory relay for local development (no external dependency)
# - Events stored in memory, forwarded between WebSocket connections
# - Automatically started via attachMockRelay(httpServer) in index.ts:592
# - See: apps/server/services/mock-relay.ts

# ── Tick Rates (ms) ──────────────────────────────────────────────────────────
# Notification/Ticket-Polling (NotificationContext + TicketPollingContext)
VITE_POLL_INTERVAL_MS=5000
# Ticket-Detail Auto-Refresh (Tickets.tsx – Status-Updates im Detail-View)
VITE_TICKET_REFRESH_MS=5000
# Lightning Payment-Status Poll (TicketDetailView – Invoice bezahlt?)
VITE_PAYMENT_POLL_MS=5000
# Home Offers Hintergrund-Refresh (Home.tsx)
VITE_HOME_REFRESH_MS=5000

# Marketplace map tile provider (ADR-406 D2 / FU-919). Default: OSM standard
# tiles (free, attribution required). Set an XYZ template to switch providers
# without touching the map component.
# VITE_MAP_TILE_URL=https://tile.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© Example Maps
# VITE_MAP_TILE_MAX_ZOOM=19

# ── LNbits Configuration ─────────────────────────────────────────────────────
# Optional – falls back to mock Lightning if not set.
# Get keys from your LNbits wallet: https://demo.lnbits.com or self-hosted.
# LNBITS_URL=https://demo.lnbits.com
# LNBITS_ADMIN_KEY=your_admin_key_here
# LNBITS_INVOICE_KEY=your_invoice_read_key_here

# ── Workspace compute funding — platform wallet (ADR-351) ───────────────────
# Colabonate's own Lightning Address (LUD-16). Workspace mandatory-funding
# (FU-376) and recharge (FU-433) payments go here, not to the seller — they
# fund real ICP cycle consumption Colabonate itself pays for. Optional in
# dev/beta mode (BETA_MODE=true falls back to a simulated DEMO rail).
# PLATFORM_LN_ADDRESS=name@domain

# ── Foundation DAO Admin (ADR-125) ───────────────────────────────────────────
# Required for `npx pnpm prisma:seed` to create Foundation DAO + ADMIN member.
# Without this, the admin menu under Start will not appear.
#
# How to get your hex pubkey:
#   node -e "const {bech32}=require('bech32'); const d=bech32.decode('npub1...'); console.log(Buffer.from(bech32.fromWords(d.words)).toString('hex'))"
#
# ADMIN role auto-qualifies as ARBITRATOR (see DAO role guards in server routes).
# FOUNDATION_DAO_ADMIN_PUBKEY=your_hex_pubkey_here

# ── AI Assistant (Ollama) ──────────────────────────────────────────────────
# Defaults for the AI assistant. Overridden per-user via Settings UI (localStorage).
# VITE_OLLAMA_DEFAULT_MODEL=qwen2.5:7b-instruct-q4_K_M
# VITE_OLLAMA_TEMPERATURE=0.7
# VITE_OLLAMA_TOP_P=0.9
# VITE_OLLAMA_TOP_K=40
# VITE_OLLAMA_NUM_CTX=4096
# VITE_OLLAMA_REPEAT_PENALTY=1.1
# VITE_OLLAMA_SEED=
# VITE_OLLAMA_FREQUENCY_PENALTY=0
# VITE_OLLAMA_PRESENCE_PENALTY=0

# ── Nostr Wallet Connect / NIP-47 (ADR-208) ───────────────────────────────────
# Non-custodial user spending wallet (Alby et al.), peer of WEBLN/CASHU.
# NWC_SECRET_KEY encrypts the stored connection URI at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NWC_ENABLED=1
# NWC_SECRET_KEY=your_32_byte_hex_key_here
# NWC_REQUEST_TIMEOUT_MS=30000

# ── Google OAuth ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Feature Flags (ADR-139) ───────────────────────────────────────────────────
# SEARCH_BACKEND=meilisearch         # "meilisearch" or "database" (kill switch)
# CACHE_ENABLED=true                 # "true" or "false" (kill switch)
# NOSTR_INGEST_ENABLED=false         # Enable passive Nostr ingestion (Phase 5)
# NOSTR_RATE_LIMIT_PER_RELAY=100     # events/hour
# NOSTR_RATE_LIMIT_PER_AUTHOR=20     # events/hour
# NOSTR_INGEST_RELAY_URLS=           # Ingest-only relays, decoupled from the publish
#                                    # path (NOSTR_RELAY_URLS) — dev/beta publish to the
#                                    # local mock while ingesting from public relays.
#                                    # Falls back to NOSTR_RELAY_URLS, then the public
#                                    # defaults. Include wss://relay.conduit.market —
#                                    # Gamma-commerce merchants (Conduit) publish there.
# REMOTE_AUTO_APPROVE_TICK_MS=900000 # ADR-423 auto-approval tick interval (ms,
#                                    # default 15 min). Modes themselves are admin
#                                    # settings (FoundationSettings), not env.

# ── Geocoding (ADR-139) ──────────────────────────────────────────────────────
# GEOCODING_PROVIDER=nominatim       # "nominatim" or "mapbox"
# MAPBOX_TOKEN=                      # optional, for bulk backfill fallback

# ── ICP Workspace-Canister (ADR-311 D5, FU-432) ─────────────────────────────
# ICP_WORKSPACE_CANISTER_ID=         # Canister-Principal; leer = kein Backend,
#                                    # Workspaces bleiben ehrlich PENDING_DEPLOY
# ICP_HOST=http://127.0.0.1:4943     # lokale Replica (Default); mainnet: https://ic0.app
# ICP_WORKSPACE_SERVER_SEED=         # 64 hex chars (32-byte Ed25519 seed) — Server-Identity,
#                                    # deren Principal dem Canister als init-Arg übergeben wird
#                                    # (FU-434 Slice A AuthZ). Dev-Beispiel: $(openssl rand -hex 32)

# ── Agent Verified-Badge Attestation (ADR-315 D3, FU-450) ───────────────────
# AGENT_ATTESTATION_PRIVKEY=         # 64 hex chars (secp256k1) — dedicated platform
#                                    # signing key for the portable Kind 31423 Verified
#                                    # Agent Badge. NOT the founder identity
#                                    # (FOUNDATION_DAO_ADMIN_PUBKEY) — generate a new,
#                                    # separate keypair for this purpose only, e.g.:
#                                    #   node -e "console.log(require('nostr-tools').generateSecretKey().reduce((s,b)=>s+b.toString(16).padStart(2,'0'),''))"
#                                    # Leer = attestations are honestly skipped (isVerified
#                                    # DB column + admin badge keep working unaffected).
#
# ── Doop-hosted Canvas (ADR-342 D3/D4 Phase B, canvas.colabonate.app) ─────────
# DOOP_SERVICE_URL=                    # Base URL of the Colabonate-operated
#                                      # doop instance (the fork-side service
#                                      # router lives at /api/service/*). Leave
#                                      # empty to keep doop-hosted offers in
#                                      # DRAFT (CANVAS_HOSTED_UNAVAILABLE).
# DOOP_SERVICE_TOKEN=                  # High-entropy bearer shared with the
#                                      # doop fork's createServiceRouter() —
#                                      # server-to-server only, never the
#                                      # browser. Generate e.g.:
#                                      #   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#                                      # Joins scripts/beta/rotate-secrets.ts
#                                      # coverage (FU-558).
